# Product
APP_IDEA="AI learning-by-doing assistant. Tell it something you want to learn, and it teaches you interactively through small challenges rather than long explanations."
APP_NAME="جرّبها"
APP_LANGUAGE=ar
DART_PACKAGE_NAME=tryit
IOS_BUNDLE_ID=com.yourcompany.tryit
APP_VERSION=1.0.0+1

# Replace all example.com URLs before release.
PRIVACY_POLICY_URL=https://example.com/privacy
SUPPORT_URL=https://example.com/support
TERMS_URL=

# AI: the mobile app calls only the HTTPS proxy. Never put GROQ_API_KEY here.
AI_ENABLED=true
GROQ_API_KEY=
GROQ_PROXY_URL=https://api.example.com/groq/chat
GROQ_MODEL=llama-3.3-70b-versatile
AI_CONSENT_VERSION=1

# Purchases are disabled for this product version.
REVENUECAT_ENABLED=false
REVENUECAT_IOS_API_KEY=
REVENUECAT_ENTITLEMENT_ID=
REVENUECAT_OFFERING_ID=current
