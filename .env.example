# Product
APP_IDEA="AI learning-by-doing assistant. Tell it something you want to learn, and it teaches you interactively through small challenges rather than long explanations."
APP_NAME="جرّبها"
APP_LANGUAGE=ar
DART_PACKAGE_NAME=tryit
IOS_BUNDLE_ID=com.meratun.app
APP_VERSION=1.0.0+1

# Replace all example.com URLs before release.
PRIVACY_POLICY_URL=https://example.com/privacy
SUPPORT_URL=https://example.com/support
TERMS_URL=

# AI: the mobile app calls only this HTTPS proxy — never put a raw Groq
# API key here or anywhere in the app. The proxy (see server/groq-proxy/)
# holds the real key server-side; deploy it once, then set its public URL
# below. Not secret, so it's fine to bake in / commit here.
AI_ENABLED=true
GROQ_PROXY_URL=https://mera-tun-groq-proxy.studentabdelhak.workers.dev
AI_CONSENT_VERSION=1

# Purchases are disabled for this product version.
REVENUECAT_ENABLED=false
REVENUECAT_IOS_API_KEY=
REVENUECAT_ENTITLEMENT_ID=
REVENUECAT_OFFERING_ID=current

# Ads (AdMob, via the vendored multi_ads_admob module in lib/services/ads/).
# Mirrored as plain consts in lib/app/app_config.dart (not read via
# --dart-define, same as PRIVACY_POLICY_URL). Publisher: pub-1950848698072572.
# Real IDs are used where already created; entries still marked TODO in
# app_config.dart fall back to Google's public test IDs until you create
# the matching ad unit in the AdMob console. Android/iOS only — ads are
# skipped on the web build.
ADS_ENABLED=true
ADMOB_ANDROID_APP_ID=ca-app-pub-1950848698072572~7085690584
ADMOB_IOS_APP_ID=ca-app-pub-1950848698072572~2681637643
ADMOB_BANNER_ID_ANDROID=ca-app-pub-1950848698072572/9739774080
ADMOB_BANNER_ID_IOS=ca-app-pub-1950848698072572/7722211330
ADMOB_INTERSTITIAL_ID_ANDROID=ca-app-pub-1950848698072572/5417385691
ADMOB_INTERSTITIAL_ID_IOS=ca-app-pub-1950848698072572/9773659601
# TODO: create these ad units in AdMob and fill them in (see app_config.dart
# for the current test-ID fallbacks): rewarded, native, app open.

# Optional: override ad unit IDs at runtime from a JSON file (see
# config/ads_config.json) hosted on Google Drive — share it as "Anyone with
# the link", then build the direct-download URL from the file ID in that
# link: https://drive.google.com/uc?export=download&id=FILE_ID
# Fetched with a 5s timeout in lib/services/ads/ads_bootstrap.dart; any
# failure (offline, malformed JSON, etc.) silently falls back to the local
# ADMOB_* IDs above, so this can never break ads. Defaults to the file
# already uploaded (see AppConfig.adsRemoteConfigUrl); leave blank to keep
# that default, or set here to point at a different file — this one IS
# read via --dart-define, e.g.:
#   flutter run --dart-define=ADS_REMOTE_CONFIG_URL=...
ADS_REMOTE_CONFIG_URL=https://drive.google.com/uc?export=download&id=1iU19zP5aNf3rM0_GFkKtpQNRreEMuWF_
